# 虚拟环境 / 编辑器
.venv/
.idea/
.vscode/
__pycache__/
*.py[cod]

# 本地密钥
.env

# 用户对话存档（属于个人数据，绝不入库）
# 只保留占位文件：原来写的是 "sessions/*.json"，改成"一个会话一个目录"之后
# 子目录（branches/、attachments/）绕过了那条规则，被误传进了仓库
sessions/*
!sessions/.gitkeep

# 测试运行时的临时文件
tests/.tmp/
._*.log
.gitmsg.txt

# 工具技能包（由客户端生成）
.agents/
.claude/

# git 历史的本地备份（bundle 里含有旧历史）
*.bundle

# 存档只应放在项目根的 sessions/：包内这个目录是拆包时 BASE_DIR 算错留下的，防止再出现
lingheng/sessions/

# 本地 secrets（含 key 与用户表，绝不入库）
.streamlit/secrets.toml
# 测试用的隔离临时根目录（run_tests.py 给每个套件分配一个）
tests/.tmp_run*

tests/.tmp_msg.txt

# 本地登录配置（含用户名与密码哈希，绝不入库）
auth_config.yaml

# 跑测试 / 启动探针留下的输出（本地排查用，不入库）
tests/.run*.txt
tests/.boot*.txt
tests/.uid.txt
