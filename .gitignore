# 虚拟环境 / 编辑器
.venv/
.idea/
.vscode/
__pycache__/
*.py[cod]

# 本地密钥
.env

# 用户对话存档（属于个人数据，绝不入库）
# 只保留占位文件：原来写的是 sessions/*.json，改成"一个会话一个目录"之后
# 子目录（branches/、attachments/）绕过了那条规则，被误传进了仓库
sessions/*
!sessions/.gitkeep

# 测试运行时的临时文件
tests/.tmp/
._*.log
.gitmsg.txt

# 工具技能包（由客户端生成）
.agents/
.claude/

# git 历史的本地备份（bundle 里含有旧历史）
*.bundle

# 一次性维护脚本（只在本地跑过，不入库）
tests/rewrite_history.py
