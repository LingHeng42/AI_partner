# 凌恒的酒馆 —— 服务器侧配置模板
#
# 用法：
#   1) 本地开发：复制成 .streamlit/secrets.toml 并填写（该文件已被 .gitignore 忽略）
#   2) Streamlit Community Cloud：把内容粘贴到 App 的 Settings → Secrets
#
# 这里放的全是**服务器侧**的东西，浏览器永远拿不到。
# 注意：TOML 的键名要用英文/数字（不能写中文当键名），中文请写进注释或字符串值里。

# --------------------------------------------------------------------------- #
# 1. 站长的 DeepSeek Key（可选）
#    只有当用户"没填自己的 key"且"在下面的允许名单里"时才会用到。
#    完全不配也行 —— 那就所有人都必须填自己的 key。
# --------------------------------------------------------------------------- #
DEEPSEEK_API_KEY = "sk-替换成你的key"

# 允许使用上面这把 key 的用户名（和下面用户表里的键名一致，大小写不敏感）
# 留空 = 谁都不能用你的 key（有意的 fail-closed 默认值，防止配置写错就全员花你的钱）
ALLOWED_USERS = ["owner", "friend1"]

# --------------------------------------------------------------------------- #
# 2. 签名 cookie 的密钥（记住登录状态用）
#    请换成一串足够长的随机字符。生成：
#      python -c "import secrets; print(secrets.token_hex(32))"
# --------------------------------------------------------------------------- #
COOKIE_KEY = "替换成一串随机字符"

# --------------------------------------------------------------------------- #
# 3. 用户表：这个应用不开放自助注册，账号由你手动维护在这里。
#    password 建议用哈希（运行 tests/make_credentials.py 生成）；明文也能用，
#    但明文会以明文形式留在 secrets 里，不推荐。
# --------------------------------------------------------------------------- #
AUTH_CREDENTIALS = { usernames = { owner = { email = "you@example.com", name = "你的名字", password = "$2b$12$替换成哈希" }, friend1 = { email = "friend1@example.com", name = "朋友1", password = "$2b$12$替换成哈希" } } }

# --------------------------------------------------------------------------- #
# 4. 存档存哪
#
# 配了 MONGO_URI 就用 MongoDB（线上必须用它），不配就用本地文件系统（本地开发）。
#
# 为什么线上必须配：Community Cloud 的容器本地文件**随时会被重置**（休眠、改设置、
# push 代码、平台维护都会触发），不接外部数据库的话会话历史会丢。
#
# 免费的 MongoDB Atlas 集群即可，连接串形如：
#   mongodb+srv://<用户>:<密码>@<集群>.mongodb.net/?retryWrites=true&w=majority
# 数据库名固定用 lingheng，集合名固定用 files（每个文件一条文档）。
# --------------------------------------------------------------------------- #
MONGO_URI = "mongodb+srv://替换成你的连接串"
